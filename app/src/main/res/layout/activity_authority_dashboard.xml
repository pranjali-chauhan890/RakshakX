<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9">

    <!-- MAIN CONTENT -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- TOOLBAR - Enhanced Gradient -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@drawable/toolbar_gradient"
            android:elevation="8dp">

            <ImageView
                android:id="@+id/iv_menu"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="10dp"
                android:src="@drawable/ic_menu_white"
                android:contentDescription="Menu"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Authority Dashboard"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:letterSpacing="0.05"/>

            <!-- Decorative element -->
            <View
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end"
                android:visibility="invisible"/>
        </androidx.appcompat.widget.Toolbar>

        <!-- SCROLL CONTENT -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/toolbar"
            android:padding="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Header with Icon -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="70dp"
                        android:layout_height="70dp"
                        android:text="📊"
                        android:textSize="42sp"
                        android:gravity="center"
                        android:background="@drawable/header_circle_bg"
                        android:padding="12dp"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Predictive Safety Analytics"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#D32F2F"
                        android:gravity="center"
                        android:layout_marginTop="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Real-time Risk Intelligence"
                        android:textSize="14sp"
                        android:textColor="#757575"
                        android:gravity="center"
                        android:layout_marginTop="4dp"/>

                </LinearLayout>

                <!-- Analytics Card - Enhanced -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="8dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Header with icon -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="12dp">
                            <TextView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:text="📋"
                                android:textSize="20sp"
                                android:gravity="center"/>
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Key Statistics"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="#333333"/>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_total_reports"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="📌 Total Citizen Complaints : 0"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#1976D2"
                            android:padding="12dp"
                            android:background="@drawable/stats_item_bg"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/tv_high_risk_zones"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🔴 Predicted High Risk Zones : 0"
                            android:textSize="15sp"
                            android:textColor="#F44336"
                            android:padding="12dp"
                            android:background="@drawable/stats_item_bg"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/tv_medium_risk_zones"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🟡 Predicted Medium Risk Zones : 0"
                            android:textSize="15sp"
                            android:textColor="#FF9800"
                            android:padding="12dp"
                            android:background="@drawable/stats_item_bg"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:id="@+id/tv_low_risk_zones"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="🟢 Predicted Safe Zones : 0"
                            android:textSize="15sp"
                            android:textColor="#4CAF50"
                            android:padding="12dp"
                            android:background="@drawable/stats_item_bg"
                            android:layout_marginBottom="8dp"/>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#E0E0E0"
                            android:layout_marginVertical="12dp"/>

                        <TextView
                            android:id="@+id/tv_avg_risk_score"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="📈 Area Risk Index : 0"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#3F51B5"
                            android:padding="12dp"
                            android:background="@drawable/stats_item_bg_accent"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Insights Section Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:text="🚨"
                        android:textSize="20sp"
                        android:gravity="center"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Predictive Insights"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#212121"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Based on complaints"
                        android:textSize="12sp"
                        android:textColor="#757575"/>

                </LinearLayout>

                <!-- Insights Card - Enhanced -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="4dp"
                    app:cardBackgroundColor="#FFFFFF">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:id="@+id/tv_prediction_1_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="10dp"
                            android:background="@drawable/insight_item_bg"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:text="🎯"
                                android:textSize="16sp"/>
                            <TextView
                                android:id="@+id/tv_prediction_1"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Monitoring complaint density patterns..."
                                android:textSize="14sp"
                                android:textColor="#555555"
                                android:layout_marginStart="12dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tv_prediction_2_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="10dp"
                            android:background="@drawable/insight_item_bg"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:text="🔄"
                                android:textSize="16sp"/>
                            <TextView
                                android:id="@+id/tv_prediction_2"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Analyzing repeated incident locations..."
                                android:textSize="14sp"
                                android:textColor="#555555"
                                android:layout_marginStart="12dp"/>
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/tv_prediction_3_layout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="10dp"
                            android:background="@drawable/insight_item_bg">

                            <TextView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:text="💡"
                                android:textSize="16sp"/>
                            <TextView
                                android:id="@+id/tv_prediction_3"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Generating safety recommendations..."
                                android:textSize="14sp"
                                android:textColor="#555555"
                                android:layout_marginStart="12dp"/>
                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <!-- Report History Title -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📜 Report History"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:padding="12dp"
                    android:layout_marginTop="12dp"/>

                <!-- RecyclerView -->

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerReports"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"/>

                <!-- Bottom Space -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="80dp"/>

            </LinearLayout>

        </ScrollView>

        <!-- FAB with Shadow -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabMap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="24dp"
            android:src="@android:drawable/ic_dialog_map"
            android:contentDescription="Map"
            app:backgroundTint="#D32F2F"
            app:elevation="8dp"
            app:rippleColor="#80FFFFFF"/>

    </RelativeLayout>

    <!-- NAVIGATION DRAWER -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/authority_navigation_menu"
        app:headerLayout="@layout/nav_header"/>

</androidx.drawerlayout.widget.DrawerLayout>